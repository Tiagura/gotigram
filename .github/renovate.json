{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "enabledManagers": [
    "github-actions",
    "gomod",
    "dockerfile"
  ],

  "dependencyDashboard": true,

  "labels": [
    "dependencies"
  ],

  "commitMessagePrefix": "chore(deps):",

  "prConcurrentLimit": 2,

  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Group Go and Docker updates",
      "matchManagers": [
        "gomod",
        "dockerfile"
      ],
      "groupName": "Go and Docker dependencies",
      "groupSlug": "go-docker"
    }
  ]
}